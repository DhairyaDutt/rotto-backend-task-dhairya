# Proxy settings (copy the real values from your assessment brief into .env)
PROXY_HOST=pr.oxylabs.io
PROXY_PORT=7777
PROXY_USERNAME=put-username-here
PROXY_PASSWORD=put-password-here

# Where the database lives (matches docker-compose.yml, no need to change)
DATABASE_URL=postgresql://rotto:rotto@localhost:5432/rotto

# Safety limit: stop after this many requests (protects your 10 GB)
MAX_REQUESTS=900
MAX_MEGABYTES=1200
MAX_RETRIES=3
REQUEST_TIMEOUT=30
# Crawl shape (defaults are fine)
SOURCES=linkedin,reed,indeed
REFRESH_DAYS=5
STALE_DAYS=3
MAX_VERIFY=20
REED_PAGES=2
INDEED_PAGES=2
# Cost estimate used in output/report.json
PROXY_USD_PER_GB=5.0
MAX_SEARCHES=12
